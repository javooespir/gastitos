generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id              String           @id @default(uuid())
  fecha           DateTime         @default(now())
  categoria       String
  montoARS        Float
  montoUSD        Float
  tipo            String           // gasto | ingreso | inversion | ahorro
  descripcion     String?
  cuenta          String           @default("Billetera")
  etiquetas       String           @default("[]")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  goalAllocations GoalAllocation[]
}

model Goal {
  id                     String           @id @default(uuid())
  nombre                 String
  montoObjetivoUSD       Float
  fechaTargetInicio      DateTime
  fechaTargetFin         DateTime
  ahorroActualUSD        Float            @default(0)
  recomendacionInversion String?
  estado                 String           @default("en_progreso")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  allocations            GoalAllocation[]
}

model GoalAllocation {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  goalId        String
  goal          Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  montoUSD      Float
  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@index([goalId])
}

model FixedExpense {
  id         String    @id @default(uuid())
  nombre     String
  monto      Float
  categoria  String
  diaMes     Int       @default(1)
  activo     Boolean   @default(true)
  ultimoPago DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Loan {
  id                  String        @id @default(uuid())
  nombre              String
  tipo                String        // hipotecario | personal | auto | otro
  saldoActual         Float
  tasaAnual           Float
  esUVA               Boolean       @default(false)
  totalCuotas         Int
  cuotaPagada         Int           @default(0) // última cuota pagada
  montoCuotaActual    Float
  montoCuotaOriginal  Float
  fechaPrimeraCuota   DateTime
  diaPago             Int           @default(10)
  estado              String        @default("activo") // activo | cancelado
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  pagos               LoanPayment[]
}

model LoanPayment {
  id           String   @id @default(uuid())
  loanId       String
  loan         Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  numeroCuota  Int
  montoPagado  Float
  fecha        DateTime
  createdAt    DateTime @default(now())

  @@index([loanId])
}

model Insight {
  id        String   @id @default(uuid())
  fecha     DateTime @default(now())
  tipo      String
  categoria String
  mensaje   String
  impacto   String
  accion    String
  leido     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ExchangeRateCache {
  id          String   @id @default("singleton")
  rateBlue    Float
  rateOficial Float
  updatedAt   DateTime @updatedAt
}
